{
  "version": 1,
  "runtimes": [
    {
      "id": "claude_code",
      "label": "Claude Code",
      "binaries": [
        "claude"
      ],
      "quotaProvider": "claude",
      "configPath": ".claude/settings.json",
      "registration": "claude_json",
      "reportsModel": "never",
      "icon": "claude_code",
      "manualSnippet": []
    },
    {
      "id": "codex",
      "label": "Codex",
      "binaries": [
        "codex"
      ],
      "quotaProvider": "codex",
      "configPath": ".codex/hooks.json",
      "registration": "codex_native",
      "reportsModel": "sometimes",
      "icon": "codex",
      "manualSnippet": []
    },
    {
      "id": "cursor",
      "label": "Cursor",
      "binaries": [
        "cursor-agent"
      ],
      "quotaProvider": "cursor",
      "configPath": ".cursor/hooks.json",
      "registration": "cursor_json",
      "reportsModel": "never",
      "icon": "cursor",
      "manualSnippet": []
    },
    {
      "id": "kimi_code",
      "label": "Kimi Code",
      "binaries": [
        "kimi"
      ],
      "quotaProvider": "kimi",
      "configPath": ".kimi/config.toml",
      "registration": "manual",
      "reportsModel": "sometimes",
      "icon": "kimi_code",
      "manualSnippet": [
        "# Kimi Code hooks live in config.toml, but their event coverage is",
        "# unconfirmed against the installed version. Wire its session events to",
        "# the hook binary, e.g.:",
        "#   \"{command}\" --source kimi_code --event session-start --session-id <session> --cwd <dir> --model <model>"
      ]
    },
    {
      "id": "pi",
      "label": "Pi",
      "binaries": [
        "pi"
      ],
      "quotaProvider": null,
      "configPath": ".pi/agent/settings.json",
      "registration": "manual",
      "reportsModel": "always",
      "icon": "pi",
      "manualSnippet": [
        "// Pi has no hook-command config: it fires session_start/session_shutdown",
        "// at JS extensions. Save this as ~/.pi/agent/extensions/siqshift.js, which",
        "// Pi auto-discovers. ctx.model names the model, recorded beside the",
        "// runtime without either one inferring the other.",
        "import { spawn } from \"node:child_process\";",
        "const fire = (event, ctx) => {",
        "  const child = spawn(\"{command}\", [",
        "    \"--source\", \"pi\", \"--event\", event,",
        "    \"--session-id\", ctx.sessionManager.getSessionId(),",
        "    \"--cwd\", process.cwd(),",
        "    \"--model\", ctx.model?.id ?? \"\",",
        "  ], { stdio: \"ignore\", detached: true });",
        "  child.unref();",
        "};",
        "export default function siqshift(pi) {",
        "  pi.on(\"session_start\", (_event, ctx) => fire(\"session-start\", ctx));",
        "  pi.on(\"session_shutdown\", (_event, ctx) => fire(\"session-end\", ctx));",
        "}"
      ]
    },
    {
      "id": "pi_signed",
      "label": "Pi (signed)",
      "binaries": [
        "pi-signed"
      ],
      "quotaProvider": null,
      "configPath": ".pi/agent/settings.json",
      "registration": "manual",
      "reportsModel": "always",
      "icon": "pi_signed",
      "manualSnippet": [
        "// pi-signed shares Pi's extension mechanism and its config directory, so",
        "// it needs its own --source to stay told apart from plain Pi. Save this",
        "// as ~/.pi/agent/extensions/siqshift-signed.js.",
        "import { spawn } from \"node:child_process\";",
        "const fire = (event, ctx) => {",
        "  const child = spawn(\"{command}\", [",
        "    \"--source\", \"pi_signed\", \"--event\", event,",
        "    \"--session-id\", ctx.sessionManager.getSessionId(),",
        "    \"--cwd\", process.cwd(),",
        "    \"--model\", ctx.model?.id ?? \"\",",
        "  ], { stdio: \"ignore\", detached: true });",
        "  child.unref();",
        "};",
        "export default function siqshiftSigned(pi) {",
        "  pi.on(\"session_start\", (_event, ctx) => fire(\"session-start\", ctx));",
        "  pi.on(\"session_shutdown\", (_event, ctx) => fire(\"session-end\", ctx));",
        "}"
      ]
    },
    {
      "id": "opencode",
      "label": "opencode",
      "binaries": [
        "opencode"
      ],
      "quotaProvider": null,
      "configPath": ".config/opencode/opencode.json",
      "registration": "manual",
      "reportsModel": "sometimes",
      "icon": "opencode",
      "manualSnippet": [
        "// opencode loads plugins from ~/.config/opencode/plugins/*.js. Save this",
        "// as siqshift.js there; opencode picks it up on its next start. It has no",
        "// session-end event, so session.idle reports a heartbeat and SIQshift",
        "// infers the boundary from gaps through the server's staleness window.",
        "// Neither event names the model, and reading the configured one back is",
        "// unconfirmed, so this reports none.",
        "import { spawn } from \"node:child_process\";",
        "const fire = (event, sessionId, directory) => {",
        "  const child = spawn(\"{command}\", [",
        "    \"--source\", \"opencode\", \"--event\", event,",
        "    \"--session-id\", sessionId, \"--cwd\", directory,",
        "  ], { stdio: \"ignore\", detached: true });",
        "  child.unref();",
        "};",
        "export const SIQshift = async ({ directory }) => ({",
        "  event: async ({ event }) => {",
        "    if (event.type === \"session.created\") {",
        "      fire(\"session-start\", event.properties.info.id, directory);",
        "    } else if (event.type === \"session.idle\") {",
        "      fire(\"heartbeat\", event.properties.sessionID, directory);",
        "    }",
        "  },",
        "});"
      ]
    },
    {
      "id": "grok",
      "label": "Grok",
      "binaries": [
        "grok"
      ],
      "quotaProvider": "grok",
      "configPath": ".grok/settings.json",
      "registration": "manual",
      "reportsModel": "sometimes",
      "icon": "grok",
      "manualSnippet": [
        "# Grok's hook mechanism is unconfirmed against any installed version.",
        "# Wire its session events to the hook binary, e.g.:",
        "#   \"{command}\" --source grok --event session-start --session-id <session> --cwd <dir> --model <model>"
      ]
    },
    {
      "id": "muse",
      "label": "Muse",
      "binaries": [
        "muse"
      ],
      "quotaProvider": null,
      "configPath": ".muse/settings.json",
      "registration": "manual",
      "reportsModel": "sometimes",
      "icon": "muse",
      "manualSnippet": [
        "# Muse's hook mechanism is unconfirmed against any installed version.",
        "# Wire its session events to the hook binary, e.g.:",
        "#   \"{command}\" --source muse --event session-start --session-id <session> --cwd <dir> --model <model>"
      ]
    },
    {
      "id": "copilot",
      "label": "GitHub Copilot",
