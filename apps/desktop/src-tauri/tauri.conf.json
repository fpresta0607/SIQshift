{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIQshift",
  "version": "0.2.2",
  "identifier": "com.siqshift.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SIQshift",
        "width": 520,
        "height": 920,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/siqshift-hook", "binaries/siqshift-browser-host"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fpresta0607/SIQshift/releases/download/unsigned-latest/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwRERGNjNDNDY5N0E5MTQKUldRVXFaZEdQUGJkUU9VaHJxTFhYRXovdzUrVkZGSGkyc0wxZE9lekI3RUFaeTNrRjhCQStNK0IK"
    }
  }
}
