{
  "name": "@siqshift/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @siqshift/shared build && pnpm --filter @siqshift/database build && tsc --project tsconfig.json",
    "test": "pnpm --filter @siqshift/shared build && pnpm --filter @siqshift/database build && vitest run",
    "typecheck": "pnpm --filter @siqshift/shared build && pnpm --filter @siqshift/database build && tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "retention": "node --env-file-if-exists=../../.env dist/retention.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts"
  },
  "dependencies": {
    "@siqshift/database": "workspace:*",
    "@siqshift/shared": "workspace:*",
    "@hono/node-server": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.3",
    "jose": "^6.0.12",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3"
  }
}
